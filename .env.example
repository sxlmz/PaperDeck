# ============================================================================
#  paper2ppt 配置模板
#  复制为 .env 并填入真实值：cp .env.example .env
#  .env 含密钥，已在 .gitignore 中忽略，不要提交
# ============================================================================

# ---------------------------------------------------------------- 文本 LLM（必填）
# 优先级：P2P_LLM_* > SINGLE_* > DEEPSEEK_API_KEY > OPENAI_*
P2P_LLM_API_KEY=
P2P_LLM_BASE_URL=https://api.deepseek.com
P2P_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------- 视觉 VLM（可选，但强烈建议）
# 缺失时：Critic 只做确定性检查、Understand 节点跳过，其余流程不受影响
P2P_VISION_API_KEY=
P2P_VISION_BASE_URL=
P2P_VISION_MODEL=qwen3.7-flash
DASHSCOPE_API_KEY=
QWEN_EVAL_BASE=
QWEN_EVAL_MODEL=qwen3.7-flash

# VLM 审查页数上限，0 = 不限（按优先级排序后再截断）
P2P_VLM_MAX_IMAGES=0

# ---------------------------------------------------------------- MinerU 高保真解析（可选）
# 控制台 https://mineru.net/apiManage/token
# 能力：扫描件 OCR、公式 LaTeX、表格结构化、多栏阅读顺序
MINERU_API_KEY=
P2P_MINERU_API_KEY=
P2P_MINERU_BASE_URL=https://mineru.net/api/v4
P2P_MINERU_MODEL_VERSION=vlm
P2P_MINERU_ENABLED=0
P2P_MINERU_PAGE_LIMIT=200

# ---------------------------------------------------------------- Embedding（预留给 RAG）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBED_DIM=1024

# ---------------------------------------------------------------- Redis 缓存
# 独立 db + 前缀，与其它业务缓存物理隔离
P2P_REDIS_HOST=127.0.0.1
P2P_REDIS_PORT=6379
P2P_REDIS_DB=2
P2P_REDIS_PREFIX=p2p:

# ---------------------------------------------------------------- 其它
TAVILY_API_KEY=
P2P_RAG_ENABLED=0
# 系统代理失效时取消注释，让 LLM 调用直连
# NO_PROXY=*
